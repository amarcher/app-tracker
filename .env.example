# GA4 Data API — service account credentials
GOOGLE_APPLICATION_CREDENTIALS=./ga4-key.json
GA4_KEY_JSON=                          # Alternative: inline JSON (for Vercel)

# GA4 Property IDs — one per monitored project
GA4_PROPERTY_ID=                       # Animal Pen Pals
GA4_PROPERTY_ID_SPACE_EXPLORER=
GA4_PROPERTY_ID_PERIODIC_TABLE=
GA4_PROPERTY_ID_CROSSWORD_CLASH=
GA4_PROPERTY_ID_TICKET_FOR_DINNER=
GA4_PROPERTY_ID_SUPERBOWL_SQUARES=
GA4_PROPERTY_ID_TABBIT_RABBIT=
GA4_PROPERTY_ID_MARK_MY_WORDS=
GA4_PROPERTY_ID_MTG_DASH=
GA4_PROPERTY_ID_RECIPE_GUIDE=

# Google Search Console — optional explicit property URLs.
# Leave unset to auto-match accessible properties by domain. Use these when a
# project uses a URL-prefix property or a subdomain-specific property.
# Values look like: sc-domain:example.com or https://example.com/
GSC_SITE_URL_ANIMAL_PENPALS=
GSC_SITE_URL_SPACE_EXPLORER=
GSC_SITE_URL_PERIODIC_TABLE=
GSC_SITE_URL_CROSSWORD_CLASH=
GSC_SITE_URL_TICKET_FOR_DINNER=
GSC_SITE_URL_SUPERBOWL_SQUARES=
GSC_SITE_URL_TABBIT_RABBIT=
GSC_SITE_URL_MARK_MY_WORDS=
GSC_SITE_URL_MTG_DASH=
GSC_SITE_URL_RECIPE_GUIDE=

# ElevenLabs — account-wide usage stats
ELEVENLABS_API_KEY=

# ElevenLabs Conversational AI — per-project agent IDs (optional)
# Each of these maps a project key to an ElevenLabs agent. Leave unset to
# disable the Conversational AI section for that project.
ELEVENLABS_AGENT_ID_ANIMAL_PENPALS=
ELEVENLABS_AGENT_ID_SPACE_EXPLORER=
ELEVENLABS_AGENT_ID_PERIODIC_TABLE=
ELEVENLABS_AGENT_ID_CROSSWORD_CLASH=
ELEVENLABS_AGENT_ID_MARK_MY_WORDS=

# Neon Postgres — self-instrumented API usage logs
DATABASE_URL=

# Cloudflare — CDN and R2 stats (per-project)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID_ANIMAL_PENPALS=
CLOUDFLARE_ZONE_ID_PERIODIC_TABLE=
# CLOUDFLARE_ZONE_ID_SPACE_EXPLORER=   # when active

# App Store Connect — iOS app stats (Space Race)
ASC_KEY_ID=            # App Store Connect API key ID
ASC_ISSUER_ID=         # App Store Connect API issuer ID
ASC_PRIVATE_KEY=       # Contents of the AuthKey_<KEY_ID>.p8 file (multiline PEM)
ASC_VENDOR_NUMBER=     # From ASC > Payments and Financial Reports (enables downloads chart)
ASC_SALES_KEY_ID=      # Optional: separate key with Sales role for salesReports
ASC_SALES_PRIVATE_KEY= # Optional: its .p8 contents (falls back to ASC_PRIVATE_KEY)
# Daily active devices come from the Analytics Reports API, which reuses the
# sales key above. Apple only generates those reports after an ADMIN-role key
# opts the app in once: scripts/asc-analytics-request.mjs <appId>
ASC_ANALYTICS_KEY_ID=      # Optional: separate key for analyticsReports
ASC_ANALYTICS_PRIVATE_KEY= # Optional: its .p8 contents (falls back to the sales key)
APP_STORE_APP_ID_SPACE_RACE=6788064058

# Amazon Appstore — Fire tablet stats (Space Race)
# Create a security profile and attach it to the "Reporting API" under
# Developer Console > My Settings > API Access, then paste the pair here.
# Scope used: adx_reporting::appstore:marketer
AMAZON_REPORTING_CLIENT_ID=
AMAZON_REPORTING_CLIENT_SECRET=
AMAZON_ASIN_SPACE_RACE=    # Optional: filters the sales report on a multi-app account
# Installs and DAU/WAU/MAU have NO Amazon API. They arrive via
# scripts/ingest-amazon-reports.mjs, which reads Download Center CSVs into DATABASE_URL.

# Also set DASHBOARD_DATABASE_URL on each monitored project's hosting platform
